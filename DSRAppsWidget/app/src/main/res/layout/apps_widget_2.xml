<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="5dp">

        <LinearLayout
            android:id="@+id/tile_claude"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/tile_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_claude" />

            <TextView
                style="@style/TileLabel"
                android:text="Claude" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_duolingo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/tile_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_duolingo" />

            <TextView
                style="@style/TileLabel"
                android:text="Duolingo" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_clock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/tile_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_clock" />

            <TextView
                style="@style/TileLabel"
                android:text="Clock" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_calculator"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/tile_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_calculator" />

            <TextView
                style="@style/TileLabel"
                android:text="Calc" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_translate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/tile_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_translate" />

            <TextView
                style="@style/TileLabel"
                android:text="Translate" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_soundcore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/tile_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_soundcore" />

            <TextView
                style="@style/TileLabel"
                android:text="Anker" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_plex"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/tile_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_plex" />

            <TextView
                style="@style/TileLabel"
                android:text="Plex" />
        </LinearLayout>
</LinearLayout>
