<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dsr_tile_pressed" />
            <stroke android:width="1.5dp" android:color="@color/dsr_gold" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dsr_tile_bg" />
            <stroke android:width="1.5dp" android:color="@color/dsr_gold_dim" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
