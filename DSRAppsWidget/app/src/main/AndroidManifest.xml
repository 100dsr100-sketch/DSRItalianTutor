<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ hides other apps unless we declare the ones we launch. -->
    <queries>
        <package android:name="com.google.android.keep" />
        <package android:name="com.google.android.apps.docs" />
        <package android:name="com.google.android.apps.photos" />
        <package android:name="com.sec.android.gallery3d" />
        <package android:name="com.sec.android.app.music" />
        <package android:name="com.sec.android.app.shealth" />
        <package android:name="com.sec.android.app.myfiles" />
        <package android:name="com.anthropic.claude" />
        <package android:name="com.duolingo" />
        <package android:name="com.sec.android.app.clockpackage" />
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.sec.android.app.popupcalculator" />
        <package android:name="com.google.android.calculator" />
        <package android:name="com.google.android.apps.translate" />
        <package android:name="com.oceanwing.soundcore" />
        <package android:name="com.plexapp.android" />
        <package android:name="com.commbank.netbank" />
        <package android:name="com.binance.dev" />
        <package android:name="au.com.commsec.android.CommSec" />
        <package android:name="au.com.macquarie.banking" />
        <package android:name="au.com.commsec.android.CommSecPocket" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.greater.Greater" />
        <!-- Lets LaunchActivity find installed apps by name. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".InfoActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".AppsWidgetProvider"
            android:label="@string/widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/apps_widget_info" />
        </receiver>

        <receiver
            android:name=".AppsWidget2Provider"
            android:label="@string/widget_2_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/apps_widget_2_info" />
        </receiver>

        <receiver
            android:name=".AppsWidget3Provider"
            android:label="@string/widget_3_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/apps_widget_3_info" />
        </receiver>

        <receiver
            android:name=".AppsWidget4Provider"
            android:label="@string/widget_4_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/apps_widget_4_info" />
        </receiver>

        <activity
            android:name=".LaunchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
